# Database Configuration (SQLite WAL mode enabled automatically)
DATABASE_URL=sqlite:///./bookleaf.db

# JWT Authentication Settings
JWT_SECRET_KEY=bookleaf-super-secret-jwt-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / LLM Configuration
# Supported providers: groq | gemini | openai
# Note: If LLM_API_KEY is empty or unreachable, the backend gracefully degrades
# to the deterministic context-aware BookLeaf triage & response engine.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
